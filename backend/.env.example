# HoloTutor Backend Configuration
# Copy this file to .env and fill in your values

# App Settings
DEBUG=false
API_VERSION=v1

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/holotutor

# JWT Secret (generate a secure random key - at least 32 characters)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY

# Firebase Configuration (optional - for Firebase auth integration)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=your-firebase-api-key

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Avatar API Keys (optional - for video avatars)
HEYGEN_API_KEY=your-heygen-key
DID_API_KEY=your-did-key

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
